# CARES configuration template. Copy to .env and fill in real values.
# NEVER commit .env. Real keys/tokens belong only in your local .env.

# ---- Guardian SMS (TextBee) ---------------------------------------------
# mock = simulated notifications only (default, safe). textbee = real SMS.
CARES_SMS_PROVIDER=mock
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id

# ---- Real-SMS presentation demo (OFF by default) -------------------------
# A demo alert is always MOCK unless this is true AND CARES_SMS_PROVIDER=textbee
# AND the "Send a real SMS" box is ticked when starting the demo.
CARES_DEMO_REAL_SMS=false

# ---- Hardware (ESP32 GPS location + timestamp) ---------------------------
# Shared secret the ESP32 sends in the X-Device-Token header.
CARES_DEVICE_TOKEN=replace_with_a_long_random_string
# Numeric ID of the CARES user account that owns hardware readings.
CARES_HARDWARE_USER_ID=1
# A GPS fix older than this is reported to guardians as unavailable.
CARES_LOCATION_MAX_AGE_SECONDS=300
# Device timestamps further than this from server time are ignored.
CARES_DEVICE_TIME_MAX_SKEW_SECONDS=300

# ---- Optional ------------------------------------------------------------
# GOOGLE_GEOCODING_API_KEY=your_google_geocoding_key
# CARES_HOST=127.0.0.1
# CARES_PORT=8000
# CARES_DB_PATH=data/cares.sqlite3
